# 本文件仅为占位示例（不含真实值）。生产部署：所有真实值由部署平台的环境变量注入，
# 不落包、不落仓库。缺关键项时 deploy.sh 会启动失败并提示。
PORT=8080
DATA_DIR=./data

# 站点对外公网根（前端访问/正文链接用）
PUBLIC_BASE=http://localhost:8080

# 对接开发者平台「模块」身份（用于调用 /api/open/* 的 SM2 签名）。
# 先在开发者平台(developer.ssemarket.cn)注册一个模块，把注册成功弹窗里一次性下发的
# 模块私钥填到 JOIN_DEV_MODULE_PRIVATE_KEY；JOIN_DEV_MODULE_SLUG 填模块 slug。
# 并在开发者平台「模块 API → API 广场」为本模块申请/获批 oa 组权限。
DEVELOPER_API_URL=https://developer.ssemarket.cn
JOIN_DEV_MODULE_SLUG=<必填：本站在开发者平台注册的模块 slug>
JOIN_DEV_MODULE_PRIVATE_KEY=<必填：注册模块时一次性下发的模块私钥(64 hex)>

# 管理端访问口令（管理页审核入口；生产建议置于平台反代之后）
JOIN_ADMIN_TOKEN=<必填：管理口令（随机长字符串）>

# 面试/录用通知展示邮箱（可选）
JOIN_CONTACT_EMAIL=hr@ssemarket.cn

# CORS（逗号分隔；本地默认已含 localhost）
JOIN_CORS_ORIGINS=http://localhost:5175,http://localhost:8080

# MinIO（可选；四项全配才启用）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET=
MINIO_BUCKET=
