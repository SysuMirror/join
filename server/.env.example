# 本文件仅为占位示例（不含真实值）。生产部署：所有真实值由部署平台的环境变量注入，
# 不落包、不落仓库。缺关键项时 deploy.sh 会启动失败并提示。
PORT=8080
DATA_DIR=./data

# 站点对外公网根（前端访问/邮件回跳/SSO 用）
PUBLIC_BASE=http://localhost:8080

# 对接新版开发者平台（SysuMirror/developer）的 /api/join/*。
# JOIN_API_KEY 与开发者平台侧注入的 JOIN_API_KEY 必须完全一致；留空时项目广场返回 503。
DEVELOPER_API_URL=https://developer.ssemarket.cn
JOIN_API_KEY=<与开发者平台一致的共享密钥>
# 简历外链签名（开发者平台的 leader 免登录打开 PDF）；不填则复用 JOIN_SESSION_SECRET
JOIN_RESUME_LINK_SECRET=
JOIN_RESUME_LINK_DAYS=90

# ---- 邮箱登录（验证码式） ----
JOIN_MAIL_LOGIN=true
# 登录会话签名密钥（必填：随机长字符串，由部署平台注入）
JOIN_SESSION_SECRET=<必填：随机长字符串>
# 验证码有效期（秒）与同邮箱发码间隔（秒）
JOIN_MAIL_CODE_TTL=300
JOIN_MAIL_CODE_RESEND=60
# 管理端白名单邮箱（逗号分隔；登录此邮箱的用户才可进入管理后台）
# 例：JOIN_ADMIN_EMAILS=3238499590@qq.com,admin@ssemarket.cn
# 注意：也可在管理后台「站点配置 → 管理员邮箱」动态登记，两种来源二选一命中即可登录
JOIN_ADMIN_EMAILS=

# SMTP（发验证码邮件；二选一风格，四项全配才启用）
# 经典风格：
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 平台风格（兼容，优先级低于 SMTP_HOST/...）：
# SMTP_ADDR=smtp.example.com:465
# SMTP_EMAIL_USERNAME=
# SMTP_EMAIL_PASSWORD=

# ---- 管理端访问口令（备选；未用邮箱登录时的回退） ----
JOIN_ADMIN_TOKEN=

# ---- UniSSO（同学统一身份登录，OAuth2 Code + PKCE / OIDC） ----
# 在 https://sso.ssemarket.cn/admin/apps 注册应用后，把 client_id / client_secret 注入。
# redirect_uri 必须与应用管理里登记的「完全一致」。
UNISSO_ISSUER=https://sso.ssemarket.cn
UNISSO_CLIENT_ID=<必填：UniSSO 应用管理里的 client_id>
UNISSO_CLIENT_SECRET=<必填：client_secret，仅服务端保存>
UNISSO_REDIRECT_URI=https://join.ssemarket.cn/api/auth/sso/callback
UNISSO_SCOPES=openid profile email
# 登录成功后默认回到前端哪个路径
UNISSO_DEFAULT_RETURN_TO=/me

# ---- 简历 PDF 上传/解析 ----
JOIN_RESUME_MAX_MB=10
JOIN_PDF_MAX_PAGES=30

# CORS（逗号分隔；本地默认已含 localhost）
JOIN_CORS_ORIGINS=http://localhost:5175,http://localhost:8080

# MinIO（可选；四项全配才启用，作为存储备份）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET=
MINIO_BUCKET=
